# Base de datos: en Vercel, la URL de Neon. En tu compu podés dejar pglite:./.data (base local sin instalar nada).
DATABASE_URL=pglite:./.data

# Contraseña para entrar al panel del equipo
PANEL_PASSWORD=cambiame

# IA (Claude). Sin clave, el asistente responde en "modo de prueba" con respuestas fijas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# WhatsApp: "simulado" no manda nada real; "real" usa la API de Meta.
WHATSAPP_MODE=simulado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=elegi-una-palabra-secreta
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
# Idioma de las plantillas aprobadas en Meta
WHATSAPP_TEMPLATE_LANG=es_AR

# Máximo de clientes distintos a los que se escribe por día (cuenta nueva de Meta: 250)
MAX_ENVIOS_POR_DIA=250

# Clave que usa Vercel para llamar al envío automático diario
CRON_SECRET=
